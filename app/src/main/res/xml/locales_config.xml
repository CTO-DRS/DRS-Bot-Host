<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the languages the app supports so Android 13+ can offer a
     per-app language choice in system settings, kept in sync with the
     in-app switcher. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
</locale-config>
