<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal prompt glyph: neon cyan chevron + cursor, inside a glass hexagon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- hexagon frame -->
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="2.5"
        android:fillType="nonZero"
        android:pathData="M54,20 L82,36 L82,72 L54,88 L26,72 L26,36 Z" />

    <!-- chevron > -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,42 L52,54 L40,66" />

    <!-- cursor _ -->
    <path
        android:strokeColor="#00FFA3"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M58,66 L70,66" />
</vector>
